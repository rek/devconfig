; Sci-fi stats HUD: clock header + CPU/RAM/temp/DL/UL rows.
; Anchored bottom-left of the laptop monitor on the background layer
; (sits below windows). Synthwave/outrun palette lives in eww.scss.

(defpoll clock-time :interval "1s" :initial "--:--:--"
  "date '+%H:%M:%S'")

(defpoll clock-date :interval "60s" :initial ""
  "date '+%a %b %d  %Y'")

(defpoll uptime :interval "30s" :initial ""
  "uptime -p | sed 's/^up //'")

(defpoll cpu :interval "2s" :initial "0"
  "~/.config/eww/scripts/cpu.sh")

(defpoll ram :interval "2s" :initial "0"
  "free | awk '/Mem:/ {printf \"%.0f\", $3/$2 * 100}'")

(defpoll temp :interval "3s" :initial "--"
  "~/.config/eww/scripts/cpu-temp.sh")

; GPU utilization %. Relaxed interval — nvidia-smi briefly wakes the dGPU.
(defpoll gpu :interval "3s" :initial "0"
  "~/.config/eww/scripts/gpu.sh")

(defpoll dl :interval "1s" :initial "0.00"
  "~/.config/eww/scripts/net-dl.sh 1")

(defpoll ul :interval "1s" :initial "0.00"
  "~/.config/eww/scripts/net-ul.sh 1")

; Claude Code usage for the active 5h block. Sourced from raw transcripts in
; ~/.claude/projects/*/*.jsonl (no API-cost figures — those would be plan
; tokens × public API rates, not actual billing). Bar denominators are set in
; the script via CC_LIMIT_* env vars / constants.
(defpoll cc-state :interval "20s" :initial "IDLE"
  "~/.config/eww/scripts/claude-usage.sh state")
(defpoll cc-remaining :interval "20s" :initial "--"
  "~/.config/eww/scripts/claude-usage.sh remaining")
(defpoll cc-sonnet-pct :interval "20s" :initial "0"
  "~/.config/eww/scripts/claude-usage.sh sonnet-pct")
(defpoll cc-all-pct :interval "20s" :initial "0"
  "~/.config/eww/scripts/claude-usage.sh all-pct")
(defpoll cc-session-pct :interval "20s" :initial "0"
  "~/.config/eww/scripts/claude-usage.sh session-pct")
(defpoll cc-session-reset :interval "30s" :initial "--"
  "~/.config/eww/scripts/claude-usage.sh session-reset")

; GitHub-style commit heatmap across ~/dev repos. Scans ~50 repos, so the
; script caches for 10 min and the poll runs on a relaxed interval.
(defpoll git-heatmap :interval "600s" :initial "[]"
  "~/.config/eww/scripts/git-heatmap.sh")

(defwidget header []
  (box :class "header" :orientation "v" :space-evenly false :spacing 4
    (box :class "brandrow" :orientation "h" :space-evenly false :spacing 20
      (label :class "brand" :text "◢ OUTRUN")
      (label :class "brand-sep" :text "//")
      (label :class "brand-sub" :text "SYS NOMINAL"))
    (label :class "clock" :text clock-time :halign "start")
    (box :class "subrow" :orientation "h" :space-evenly false :spacing 28
      (label :class "date" :text clock-date)
      (label :class "uptime" :text "▲ ${uptime}"))))

(defwidget row [lbl val ?suffix ?bar]
  (box :class "row" :orientation "h" :space-evenly false :spacing 28
    (label :class "label" :text lbl :halign "start")
    (label :class "value" :text "${val}${suffix ?: ""}" :halign "start")
    (progress :class {bar == "true" ? "bar" : "bar hidden"}
              :value {bar == "true" ? val : 0} :max 100
              :hexpand true :valign "center")))

(defwidget hud []
  (box :class "hud" :orientation "v" :space-evenly false :spacing 12
    (header)
    (box :class "divider")
    (row :lbl "CPU" :val cpu :suffix "%"    :bar "true")
    (row :lbl "RAM" :val ram :suffix "%"    :bar "true")
    (row :lbl "TMP" :val temp :suffix "°C"  :bar "false")
    (row :lbl "DL"  :val dl  :suffix " MB/s" :bar "false")
    (row :lbl "UL"  :val ul  :suffix " MB/s" :bar "false")))

(defwindow stats-hud
  :monitor "eDP-2"
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "24px" :y "24px"
                      :anchor "bottom left")
  (hud))

; Bar driven by an explicit pct (0..100); shows the percentage, not raw tokens.
(defwidget bar-row [lbl pct]
  (box :class "row" :orientation "h" :space-evenly false :spacing 22
    (label :class "label" :text lbl :halign "start")
    (label :class "value pct" :text "${pct}%" :halign "start")
    (progress :class "bar" :value pct :max 100 :hexpand true :valign "center")))

(defwidget claude-hud []
  (box :class "hud claude" :orientation "v" :space-evenly false :spacing 12
    (box :class "brandrow" :orientation "h" :space-evenly false :spacing 20
      (label :class "brand" :text "◢ CLAUDE")
      (label :class "brand-sep" :text "//")
      (label :class "brand-sub" :text cc-state))
    (box :class "divider")
    (label :class "section-title" :text "sessions" :halign "start")
    (box :class "subrow" :orientation "h" :space-evenly false :spacing 12
      (label :class "uptime" :text "weekly" :halign "start")
      (label :class "date" :text "▲ ${cc-remaining}" :halign "end" :hexpand true))
    (box :class "subrow" :orientation "h" :space-evenly false :spacing 12
      (label :class "uptime" :text "current" :halign "start")
      (label :class "date" :text "▲ ${cc-session-reset}" :halign "end" :hexpand true))
    (box :class "divider")
    (bar-row :lbl "NOW"    :pct cc-session-pct)
    (bar-row :lbl "WEEKLY" :pct cc-all-pct)
    (bar-row :lbl "SONNET" :pct cc-sonnet-pct)))

(defwindow claude-hud
  :monitor "eDP-2"
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "24px" :y "24px"
                      :anchor "bottom right")
  (claude-hud))

; Launcher panel. Lives on the foreground layer so clicks register.
; Keep it small and out of the way; the read-only HUDs stay on the bg layer.
(defwidget launch-btn [icon lbl cmd ?active]
  (button :class {active == "on" ? "launch-btn active" : "launch-btn"}
          :onclick cmd
    (box :orientation "v" :space-evenly false :spacing 2 :halign "center"
      (label :class "launch-icon" :text icon :halign "center")
      (label :class "launch-label" :text lbl :halign "center"))))

; Polled state for buttons that toggle persistent settings.
(defpoll nightlight-state :interval "3s" :initial "off"
  "~/.config/eww/scripts/nightlight-state.sh")

; Active Hyprland mode ("work" | "home" | "none"). Drives WORK/HOME button highlight.
(defpoll mode-state :interval "3s" :initial "work"
  "~/.config/eww/scripts/mode-state.sh")

; Launcher always-on-top toggle ("on" | "off"). When on, the launcher renders on
; the overlay layer (above fullscreen windows); off keeps it on the fg layer.
; Implemented as two sibling windows below — the toggle script swaps them.
(defpoll launcher-top :interval "2s" :initial "off"
  "cat ~/.local/state/eww-launcher-top 2>/dev/null || echo off")

(defwidget launcher []
  (overlay
    (box :class "launcher" :orientation "v" :space-evenly false :spacing 10
    (box :class "launcher-row mode-row" :orientation "h" :halign "center" :space-evenly false :spacing 14
      (launch-btn :icon "" :lbl "WORK"
                  :active {mode-state == "work" ? "on" : "off"}
                  :cmd "~/.config/eww/scripts/launch.sh ~/dev/devconfig/scripts/mode-button.sh work")
      (launch-btn :icon "" :lbl "HOME"
                  :active {mode-state == "home" ? "on" : "off"}
                  :cmd "~/.config/eww/scripts/launch.sh ~/dev/devconfig/scripts/mode-button.sh home")
      (launch-btn :icon "󰓹" :lbl "GLASS"
                  :cmd "~/.config/eww/scripts/launch.sh ~/.config/eww/scripts/display-switch.sh glasses-only")
      (launch-btn :icon "󰌢" :lbl "LAPTOP"
                  :cmd "~/.config/eww/scripts/launch.sh ~/.config/eww/scripts/display-switch.sh laptop"))
    (box :class "launcher-row" :orientation "h" :space-evenly false :spacing 14
    (launch-btn :icon "" :lbl "FILES"
                :cmd "~/.config/eww/scripts/launch.sh uwsm-app -- nautilus --new-window")
    (launch-btn :icon "" :lbl "LOCK"
                :cmd "~/.config/eww/scripts/launch.sh omarchy system lock")
    (launch-btn :icon "" :lbl "SHOT"
                :cmd "~/.config/eww/scripts/launch.sh omarchy capture screenshot")
    (launch-btn :icon "" :lbl "SLEEP"
                :cmd "~/.config/eww/scripts/launch.sh systemctl suspend")
    (launch-btn :icon "" :lbl "BLANK"
                :cmd "~/.config/eww/scripts/launch.sh ~/.config/eww/scripts/display-off.sh")
    (launch-btn :icon "" :lbl "NIGHT"
                :active nightlight-state
                :cmd "~/.config/eww/scripts/launch.sh omarchy toggle nightlight")
    (launch-btn :icon "" :lbl "THEME"
                :cmd "~/.config/eww/scripts/launch.sh omarchy theme bg next")))
    (button :class "launcher-pin ${launcher-top}"
            :halign "end" :valign "start"
            :onclick "~/.config/eww/scripts/launch.sh ~/.config/eww/scripts/launcher-top-toggle.sh"
      (label :text ""))))

(defwindow launcher-hud
  :monitor "eDP-2"
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "0" :y "24px"
                      :anchor "bottom center")
  (launcher))

; Same widget, but on the overlay layer so it sits above fullscreen windows.
; The launcher-top-toggle script swaps which sibling is open.
(defwindow launcher-hud-top
  :monitor "eDP-2"
  :stacking "overlay"
  :exclusive false
  :focusable false
  :geometry (geometry :x "0" :y "24px"
                      :anchor "bottom center")
  (launcher))

; ── Top HUD: live CPU/RAM/GPU sparklines + git commit heatmap ────────────────

; A single scrolling line graph. eww's `graph` keeps its own history keyed by
; :value updates over :time-range. Colour is set per-class in eww.scss.
(defwidget sparkline [lbl val cls]
  (box :class "spark" :orientation "v" :space-evenly false :spacing 4 :hexpand true
    (label :class "spark-label" :text lbl :halign "start")
    (graph :class "spark-graph ${cls}"
           :value val :time-range "90s" :max 100 :min 0
           :thickness 5 :line-style "round"
           :vexpand true :hexpand true)))

; GitHub-style contribution grid: WEEKS columns × 7 day rows. The poll
; (git-heatmap) yields a JSON array of week-columns of {date,count,level}.
(defwidget heatmap []
  (box :class "heatmap" :orientation "v" :space-evenly false :spacing 6
    (label :class "heatmap-title" :text "◢ COMMITS // 15W" :halign "start")
    (box :class "heatmap-grid" :orientation "h" :space-evenly false :spacing 3
      (for week in git-heatmap
        (box :orientation "v" :space-evenly false :spacing 3
          (for day in week
            (box :class "cell level-${day.level}"
                 :tooltip "${day.date}  ·  ${day.count} commits")))))))

(defwidget topbar []
  (box :class "topbar" :orientation "h" :space-evenly false :spacing 36
    (box :class "sparks" :orientation "h" :space-evenly false :spacing 28
      (sparkline :lbl "CPU" :val cpu :cls "cpu")
      (sparkline :lbl "RAM" :val ram :cls "ram")
      (sparkline :lbl "GPU" :val gpu :cls "gpu"))
    (box :hexpand true)
    (box :class "divider-v")
    (heatmap)))

(defwindow top-hud
  :monitor "eDP-2"
  :stacking "bottom"
  :exclusive false
  :focusable false
  :geometry (geometry :x "0" :y "0"
                      :width "100%"
                      :anchor "top center")
  (topbar))
