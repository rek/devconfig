[Unit]
# Writes ~/.local/state/omarchy/agents/usage/byteplus.json — see
# bin/omarchy-agent-usage-byteplus for why this runs as our own timer instead
# of living alongside the official collectors in $OMARCHY_PATH/bin (root-owned).
Description=BytePlus Coding Plan usage collector for the Omarchy Agents panel
After=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/dev/devconfig/bin/omarchy-agent-usage-byteplus
