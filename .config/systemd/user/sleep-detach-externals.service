[Unit]
# Turns external monitors off right before suspend and back on after resume —
# see bin/sleep-detach-externals for why.
Description=Detach external monitors around suspend
After=wayland-session-waitenv.service
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/dev/devconfig/bin/sleep-detach-externals
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
