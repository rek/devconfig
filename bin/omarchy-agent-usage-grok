#!/usr/bin/env python3
"""omarchy-agent-usage-grok — writes a usage record for Grok (xAI) into the
same directory Omarchy's Agents panel already watches
(${XDG_STATE_HOME:-~/.local/state}/omarchy/agents/usage/grok.json), so the
panel and the bar's inline chip pick it up with zero QML changes — it's the
same discovery mechanism as the official Claude/Codex/Fireworks collectors.

It can't live in $OMARCHY_PATH/bin (root-owned, package-managed) like the
official collectors, so a user systemd timer (see
.config/systemd/user/omarchy-agent-usage-grok.{service,timer}) runs this
directly on its own schedule and writes straight to the state dir. Main.qml's
FileView watches that file for changes regardless of who wrote it.

Auth comes from the Grok CLI's own OAuth session (~/.grok/auth.json) — same
session `grok login` creates and the CLI's own /usage display reads from.
The billing endpoint (cli-chat-proxy.grok.com) is the one the CLI itself
calls; this doesn't add a new credential or a new place secrets live.

v1 scope: rate-limit windows only (weekly credit pool, Grok Build sub-window,
and the "credits exhausted" state, which is common enough to be a first-class
case here). Local token/session history is NOT scanned — ~/.grok/sessions
held 93 files / 254MB on this machine, and scanning that incrementally,
cached, with subagent sessions deduped, is its own project, not a bolt-on.
The panel already hides "tokens by day/model" gracefully when a provider
reports no local stats, so this is a complete v1, not a stub.
"""
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime, timezone

GROK_HOME = os.environ.get("GROK_HOME", os.path.expanduser("~/.grok"))
AUTH_FILE = os.path.join(GROK_HOME, "auth.json")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy", "agents", "usage",
)
OUT_FILE = os.path.join(STATE_DIR, "grok.json")

BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
USER_URL = "https://cli-chat-proxy.grok.com/v1/user?include=subscription"


def now_iso():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def base_record():
    return {
        "schemaVersion": 1,
        "id": "grok",
        "name": "Grok",
        "updatedAt": now_iso(),
        "ready": False,
        "hasLocalStats": False,
        "hasPromptStats": False,
        "limits": [],
        "tierLabel": "",
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "modelUsage": {},
        "authHelpText": "",
        "usageStatusText": "",
    }


def write_record(record):
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = OUT_FILE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(record, f)
    os.replace(tmp, OUT_FILE)


def waiting_for_auth(reason, retry=False):
    record = base_record()
    record["authHelpText"] = reason
    if retry:
        record["retryAdvised"] = True
    write_record(record)


def load_token():
    with open(AUTH_FILE) as f:
        data = json.load(f)
    if not data:
        return None
    entry = next(iter(data.values()))
    return entry.get("key")


def api_get(url, token):
    req = urllib.request.Request(
        url, headers={"Authorization": "Bearer " + token, "Accept": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        return resp.status, json.loads(resp.read().decode())


# Tries a handful of plausible key spellings rather than one guess, since the
# exact response shape hasn't been observed on a non-exhausted account yet
# (this machine's team was over its spending limit at write time — see the
# 403 branch below, which WAS observed and is handled precisely).
def first_present(d, *keys):
    for k in keys:
        if isinstance(d, dict) and k in d and d[k] is not None:
            return d[k]
    return None


def as_fraction(value):
    """Normalize a percent that might arrive as 0-1 or 0-100."""
    try:
        v = float(value)
    except (TypeError, ValueError):
        return None
    return v / 100.0 if v > 1.0 else v


def parse_billing(body):
    limits = []

    weekly_pct = as_fraction(first_present(
        body, "creditUsagePercent", "credit_usage_percent", "usagePercent", "usage_percent"
    ))
    weekly_reset = first_present(body, "resetsAt", "reset_at", "nextResetAt", "next_reset_at")
    if weekly_pct is not None:
        limits.append({
            "label": "Weekly",
            "title": "Weekly",
            "percent": weekly_pct,
            "resetsAt": weekly_reset or "",
        })

    product_usage = first_present(body, "productUsage", "product_usage") or {}
    build = first_present(product_usage, "GrokBuild", "grok_build", "GROK_BUILD") or {}
    build_pct = as_fraction(first_present(build, "usagePercent", "usage_percent"))
    build_reset = first_present(build, "resetsAt", "reset_at")
    if build_pct is not None:
        limits.append({
            "label": "Grok Build",
            "title": "Grok Build",
            "percent": build_pct,
            "resetsAt": build_reset or weekly_reset or "",
        })

    return limits


def parse_tier(body):
    sub = first_present(body, "subscription", "subscriptionTier") or {}
    if isinstance(sub, str):
        return sub
    return str(first_present(sub, "tier", "name") or "")


def main():
    if not os.path.exists(AUTH_FILE):
        waiting_for_auth("Run `grok login` to authenticate.")
        return

    try:
        token = load_token()
    except (OSError, json.JSONDecodeError) as e:
        waiting_for_auth("Couldn't read ~/.grok/auth.json: " + str(e))
        return

    if not token:
        waiting_for_auth("Run `grok login` to authenticate.")
        return

    try:
        status, body = api_get(BILLING_URL, token)
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            try:
                err_body = json.loads(e.read().decode())
                message = str(err_body.get("error", "")) or ""
            except Exception:
                message = ""
            if e.code == 403 and ("credit" in message.lower() or "spending limit" in message.lower()):
                # A real, common state, not an error: the team is over its
                # cap for this cycle. Represent it as a genuine 100%-used
                # window rather than hiding it behind a generic auth prompt —
                # "capped out" is exactly the information this panel exists
                # to surface.
                record = base_record()
                record["ready"] = True
                record["limits"] = [{
                    "label": "Weekly",
                    "title": "Weekly",
                    "percent": 1.0,
                    "resetsAt": "",
                }]
                # The server's own message leads with a team UUID that's just
                # noise in the panel — show the meaningful part only.
                record["usageStatusText"] = (
                    "Credit limit reached for this cycle. Purchase more credits "
                    "or raise your spending limit to continue."
                )
                write_record(record)
            else:
                waiting_for_auth("Run `grok login` to refresh your session.")
        else:
            waiting_for_auth("Grok billing check failed (HTTP %d). Will retry." % e.code, retry=True)
        return
    except (urllib.error.URLError, TimeoutError, OSError) as e:
        waiting_for_auth("Couldn't reach Grok's billing endpoint: %s. Will retry." % e, retry=True)
        return

    limits = parse_billing(body)
    if not limits:
        waiting_for_auth(
            "Connected, but the billing response didn't match any known shape. "
            "This collector needs updating for a Grok CLI/API change."
        )
        return

    record = base_record()
    record["ready"] = True
    record["limits"] = limits

    try:
        _, user_body = api_get(USER_URL, token)
        record["tierLabel"] = parse_tier(user_body)
    except Exception:
        pass  # tier label is cosmetic; limits are what the bar needs

    write_record(record)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        waiting_for_auth("omarchy-agent-usage-grok crashed: %s" % e)
        sys.exit(1)
