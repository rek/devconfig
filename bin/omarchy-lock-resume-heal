#!/bin/bash

# Watches for resume-from-sleep and recovers Omarchy's Quickshell lock screen
# if it comes back unable to take a password.
#
# History: this originally assumed Service.qml failed to re-attach the lock
# surface after a screen change, and restarted the shell whenever the lock
# looked idle 4s after resume. Upstream review (omacom/omarchy#9325, comment
# 6079435738) showed Quickshell re-attaches surfaces itself, and an idle-but-
# healthy lock looks identical — so that version fired on every resume and was
# itself the "crash then reload" seen after waking. The likelier wedge is
# fcitx5: the password field routes every key through fcitx5-qt, which
# swallows keys while waiting on a fcitx5 that has stopped answering D-Bus.
#
# So now: log evidence at resume and leave the lock alone, give the user
# WAIT_SECONDS to unlock normally, then restart fcitx5 if it isn't answering,
# and only restart the shell as a last resort. omarchy-restart-shell refuses
# to run while the lock is secure, so that fallback inlines its logic.
# Hyprland's session-lock protocol stays engaged throughout.

set -u

CONFIG_DIR="${OMARCHY_PATH:?}/shell"
WAIT_SECONDS=60          # time to unlock normally before we touch anything
FCITX_SETTLE_SECONDS=15  # after restarting fcitx5, time for typing to work before the shell restart
POLL_SECONDS=2

log() { logger -t omarchy-lock-resume-heal "$*"; }

lock_field() {
  # $1: jq filter, $2: status JSON
  jq -r "$1" <<<"$2" 2>/dev/null
}

restart_and_relock() {
  while timeout 5 quickshell kill -p "$CONFIG_DIR" --any-display >/dev/null 2>&1; do :; done
  hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null

  local deadline=$((SECONDS + 20))
  while (( SECONDS < deadline )); do
    omarchy-shell shell ping >/dev/null 2>&1 && break
    sleep 0.2
  done

  local relock_deadline=$((SECONDS + 30)) state
  while (( SECONDS < relock_deadline )); do
    state=$(lock_field 'if .secure == true then "secure" elif .requested == true then "locking" else "idle" end' \
      "$(omarchy-shell lock status 2>/dev/null)")
    case $state in
      secure) log "recovered: shell restarted and re-secured"; return 0 ;;
      locking) ;;
      *) omarchy-shell lock lock >/dev/null 2>&1 ;;
    esac
    sleep 0.2
  done

  log "shell restarted but did not re-secure within timeout"
  return 1
}

fcitx_state() {
  # answering | wedged (running but not replying) | absent
  if busctl --user --timeout=3 call org.fcitx.Fcitx5 /controller \
      org.fcitx.Fcitx.Controller1 CurrentInputMethod >/dev/null 2>&1; then
    echo answering
  elif pgrep -u "$UID" -x fcitx5 >/dev/null; then
    echo wedged
  else
    echo absent
  fi
}

still_locked() {
  [[ $(lock_field '.secure or .requested' "$(omarchy-shell lock status 2>/dev/null)") == "true" ]]
}

# Waits up to $1 seconds for the user to unlock. Returns 0 once unlocked.
wait_for_unlock() {
  local deadline=$((SECONDS + $1)) status
  while (( SECONDS < deadline )); do
    status=$(omarchy-shell lock status 2>/dev/null) || return 0
    [[ $(lock_field '.secure or .requested' "$status") == "true" ]] || return 0
    # Mid-PAM: keep waiting rather than letting the deadline cut it off.
    [[ $(lock_field '.authenticating' "$status") == "true" ]] && deadline=$((deadline + POLL_SECONDS))
    sleep "$POLL_SECONDS"
  done
  return 1
}

heal_stuck_lock() {
  omarchy-hyprland-session-locked || return 0

  local resumed=$SECONDS
  log "resume: locked, fcitx5=$(fcitx_state), lock=$(omarchy-shell lock status 2>/dev/null) — waiting ${WAIT_SECONDS}s for a normal unlock"

  if wait_for_unlock "$WAIT_SECONDS"; then
    log "unlocked normally after $((SECONDS - resumed))s, nothing to heal"
    return 0
  fi

  local fcitx
  fcitx=$(fcitx_state)
  log "still locked after ${WAIT_SECONDS}s, fcitx5=$fcitx"
  if [[ $fcitx == wedged ]]; then
    log "fcitx5 not answering D-Bus, restarting omarchy-fcitx5.service"
    systemctl --user restart omarchy-fcitx5.service
    if wait_for_unlock "$FCITX_SETTLE_SECONDS"; then
      log "unlocked after fcitx5 restart — fcitx5 wedge confirmed"
      return 0
    fi
  fi

  still_locked || return 0
  log "still locked, falling back to restarting the Omarchy shell"
  restart_and_relock
}

consume_resume_event() {
  local line
  while IFS= read -r line; do
    if [[ $line == *"boolean false"* ]]; then
      heal_stuck_lock
      return 0
    fi
  done
}

monitor_resume_events() {
  local monitor_fd monitor_pid status

  coproc RESUME_EVENTS {
    exec dbus-monitor --system \
      "type='signal',sender='org.freedesktop.login1',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'"
  }
  monitor_fd=${RESUME_EVENTS[0]}
  monitor_pid=$RESUME_EVENTS_PID

  cleanup_monitor() {
    kill "$monitor_pid" 2>/dev/null || true
    wait "$monitor_pid" 2>/dev/null || true
  }
  trap cleanup_monitor EXIT

  consume_resume_event <&"$monitor_fd"
  status=$?
  cleanup_monitor
  trap - EXIT
  return "$status"
}

case ${1:-} in
  --test)
    # Manual trigger for testing: skips waiting for a real dbus resume event
    # and runs the same staleness check immediately.
    heal_stuck_lock
    exit 0
    ;;
esac

monitor_resume_events
