#!/bin/bash
# Wire Claude Code hooks to the zellij-agent-status plugin so zellij tabs show agent state.
# Idempotent: merges into ~/.claude/settings.json, replacing any earlier zellij-agent hooks.
set -e

SETTINGS="$HOME/.claude/settings.json"
command -v jq >/dev/null || { echo "jq required"; exit 1; }
mkdir -p "$(dirname "$SETTINGS")"
[ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
cp "$SETTINGS" "$SETTINGS.bak"

tmp=$(mktemp)
jq '
  # outside zellij: no-op. Inside: broadcast to the plugin; timeout so a missing
  # plugin can never hang the agent, stdin closed so the pipe never waits on it.
  def cmd($state):
    "[ -z \"$ZELLIJ\" ] || timeout 2 zellij pipe --name agent-status -- \"$ZELLIJ_PANE_ID:" + $state + "\" </dev/null >/dev/null 2>&1 # zellij-agent-status";
  def ours: ((.command // "") | contains("zellij-agent"));
  def add_hook($event; $state; $matcher):
    .hooks[$event] = (
      ((.hooks[$event] // [])
        | map(.hooks |= map(select(ours | not)))
        | map(select((.hooks | length) > 0)))
      + [{hooks: [{type: "command", command: cmd($state)}]}
         + (if $matcher == "" then {} else {matcher: $matcher} end)]);
  def add_hook($event; $state): add_hook($event; $state; "");
  .hooks = (.hooks // {})
  | add_hook("UserPromptSubmit"; "working")
  | add_hook("PostToolUse";      "working")
  # only real prompts: the idle reminder would turn a finished agent back to waiting
  | add_hook("Notification";     "waiting"; "permission_prompt|elicitation_dialog")
  | add_hook("Stop";             "done")
  | add_hook("SessionEnd";       "end")
' "$SETTINGS" > "$tmp"
mv "$tmp" "$SETTINGS"
echo "Claude Code zellij hooks installed in $SETTINGS"
