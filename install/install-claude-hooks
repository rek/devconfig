#!/bin/bash
# Wire Claude Code / Grok hooks to zellij-agent-status so tabs show agent state.
# Idempotent: writes the hook script, then merges into ~/.claude/settings.json
# (replacing any earlier zellij-agent hooks).
set -e

HOOK="$HOME/.config/zellij/agent-status-hook.sh"
SETTINGS="$HOME/.claude/settings.json"
command -v jq >/dev/null || { echo "jq required"; exit 1; }

mkdir -p "$(dirname "$HOOK")"
cat > "$HOOK" << 'EOF'
#!/bin/sh
# Drive zellij-agent-status from an agent hook (Claude Code or Grok).
# Usage: agent-status-hook.sh <working|waiting|done|idle|end|stop>
#
# `stop` reads hook JSON from stdin and maps Grok session teardown
# (`/exit` → reason shutdown|channel_closed) to `end`, so the tab
# badge clears instead of sticking on ✅.
set -eu

state=${1:-}
if [ -z "$state" ]; then
  echo "usage: $0 working|waiting|done|idle|end|stop" >&2
  exit 2
fi

if [ "$state" = stop ]; then
  reason=$(jq -r '.reason // empty' 2>/dev/null || true)
  case "$reason" in
    shutdown|channel_closed) state=end ;;
    *) state=done ;;
  esac
else
  cat >/dev/null 2>&1 || true
fi

[ -n "${ZELLIJ:-}" ] || exit 0
[ -n "${ZELLIJ_PANE_ID:-}" ] || exit 0

# Target the local wasm. Broadcast (`--name` only) also hits the GitHub-URL
# instance from load_plugins, which never unblocks CLI pipes, so Stop hangs
# and the hourglass sticks.
# Closed stdin: zellij pipe otherwise waits for payload on stdin.
# timeout: a missing plugin must never hang the agent.
plugin="file:${HOME}/.config/zellij/plugins/zellij-agent-status.wasm"
exec timeout 2 zellij pipe --plugin "$plugin" --name agent-status -- "${ZELLIJ_PANE_ID}:${state}" </dev/null >/dev/null 2>&1
EOF
# 755: the hook must be executable for Claude/Grok to run it.
python3 -c "import os; os.chmod('$HOOK', 0o755)"

mkdir -p "$(dirname "$SETTINGS")"
[ -f "$SETTINGS" ] || echo '{}' > "$SETTINGS"
cp "$SETTINGS" "$SETTINGS.bak"

tmp=$(mktemp)
jq --arg hook "$HOOK" '
  def cmd($state):
    ($hook) + " " + $state + " # zellij-agent-status";
  def ours: ((.command // "") | contains("zellij-agent"));
  def add_hook($event; $state; $matcher):
    .hooks[$event] = (
      ((.hooks[$event] // [])
        | map(.hooks |= map(select(ours | not)))
        | map(select((.hooks | length) > 0)))
      + [{hooks: [{type: "command", command: cmd($state)}]}
         + (if $matcher == "" then {} else {matcher: $matcher} end)]);
  def add_hook($event; $state): add_hook($event; $state; "");
  .hooks = (.hooks // {})
  | add_hook("UserPromptSubmit"; "working")
  | add_hook("PostToolUse";      "working")
  # only real prompts: the idle reminder would turn a finished agent back to waiting
  | add_hook("Notification";     "waiting"; "permission_prompt|elicitation_dialog")
  # `stop` (not `done`): Grok /exit is Stop reason shutdown, which must send `end`
  | add_hook("Stop";             "stop")
  | add_hook("SessionEnd";       "end")
' "$SETTINGS" > "$tmp"
mv "$tmp" "$SETTINGS"
echo "Claude Code zellij hooks installed in $SETTINGS"
echo "Hook script: $HOOK"
